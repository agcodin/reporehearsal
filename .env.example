DATABASE_URL=postgresql://rehearsal:rehearsal@localhost:5432/reporehearsal
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-long-random-string
CLEANUP_SECRET=replace-with-a-separate-long-random-string
# Stripe: create recurring Prices in Stripe, then set the six matching price IDs as Cloudflare Worker secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_WEEKLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_WEEKLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
# Local/e2e only. Enables header-asserted identity; MUST stay unset in production.
GATEWAY_IDENTITY_SECRET=
SANDBOX_ROOT=./work/sandboxes
SANDBOX_MAX_MINUTES=45
SANDBOX_MEMORY_MB=1024
SANDBOX_CPU_LIMIT=1
MAX_UPLOAD_MB=20
MAX_ARCHIVE_FILES=3000
DEMO_MODE=true
