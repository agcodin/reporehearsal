generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Organization { id String @id @default(cuid()) name String billingProfile BillingProfile? createdAt DateTime @default(now()) }
model BillingProfile { id String @id @default(cuid()) organizationId String @unique organization Organization @relation(fields:[organizationId],references:[id]) displayName String billingRegion String }
