{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-rehearsal",
  "main": "./dist/server/index.js",
  "assets": {
    "directory": "./dist/client"
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "reporehersal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.reporehersal.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  // Sessions expire within ~60 minutes, so purge often enough that abandoned
  // workspaces do not accumulate in R2 between runs.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repo-rehearsal",
      "database_id": "d5b8308b-5874-4a6e-9c48-64a8edb4d3bb",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPOSITORIES",
      "bucket_name": "repo-rehearsal-repositories"
    }
  ]
}
